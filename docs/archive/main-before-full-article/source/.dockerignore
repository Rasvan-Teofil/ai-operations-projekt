# Host checkouts stay out of the build context. The train stage downloads
# the sentence files itself and the runtime stage only receives joblib files.
.git
.github
.venv
venv
env
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
# Prepared splits stay out. The train stage downloads them. The sample
# CSVs are the dummy set and the handwritten opinion slice.
data/*
!data/sample
data/sample/*
!data/sample/sentiment_sample.csv
!data/sample/opinion_supplement.csv
mlruns
mlartifacts
notebooks
reports
docs
tests
